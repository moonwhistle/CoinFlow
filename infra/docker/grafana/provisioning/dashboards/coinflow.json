{
  "title": "CoinFlow Real-Time Metrics",
  "uid": "coinflow-custom-dashboard",
  "tags": ["coinflow", "monitoring"],
  "timezone": "browser",
  "panels": [
    {
      "title": "1. WebSocket Tick Receive Rate (TPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(tick_receive_count_total[1m])",
          "legendFormat": "TPS ({{application}})"
        }
      ]
    },
    {
      "title": "2. DB Persist Executor Active Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "executor_active_threads{name=\"dbPersistExecutor\"}",
          "legendFormat": "Active Threads"
        }
      ]
    },
    {
      "title": "3. Redis XADD / ACK Latency (Avg ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(stream_publish_latency_seconds_sum[1m]) / rate(stream_publish_latency_seconds_count[1m]) * 1000",
          "legendFormat": "XADD Latency (ms)"
        },
        {
          "expr": "rate(stream_ack_latency_seconds_sum[1m]) / rate(stream_ack_latency_seconds_count[1m]) * 1000",
          "legendFormat": "ACK Latency (ms)"
        }
      ]
    },
    {
      "title": "4. API Caffeine Cache Hit Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=\"ohlc_chart_cache\", result=\"hit\"}[1m])) / sum(rate(cache_gets_total{cache=\"ohlc_chart_cache\"}[1m])) * 100",
          "legendFormat": "Hit Rate (%)"
        }
      ]
    },
    {
      "title": "5. Redis XADD Latency (P95, P99 ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "stream_publish_latency_seconds{quantile=\"0.95\"} * 1000",
          "legendFormat": "XADD P95"
        },
        {
          "expr": "stream_publish_latency_seconds{quantile=\"0.99\"} * 1000",
          "legendFormat": "XADD P99"
        }
      ]
    },
    {
      "title": "6. Redis ACK Latency (P95, P99 ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "stream_ack_latency_seconds{quantile=\"0.95\"} * 1000",
          "legendFormat": "ACK P95"
        },
        {
          "expr": "stream_ack_latency_seconds{quantile=\"0.99\"} * 1000",
          "legendFormat": "ACK P99"
        }
      ]
    },
    {
      "title": "7. Main Thread vs E2E Latency (Avg ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(tick_main_thread_latency_seconds_sum[1m]) / rate(tick_main_thread_latency_seconds_count[1m]) * 1000",
          "legendFormat": "Main Thread Latency (ms)"
        },
        {
          "expr": "rate(tick_process_latency_seconds_sum[1m]) / rate(tick_process_latency_seconds_count[1m]) * 1000",
          "legendFormat": "E2E Latency (ms)"
        }
      ]
    },
    {
      "title": "8. Throttling Protection Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "values": true,
        "defaults": { "min": 0, "max": 100, "unit": "percent" }
      },
      "targets": [
        {
          "expr": "sum(rate(kline_broadcast_skipped_total[5m])) / (sum(rate(kline_broadcast_skipped_total[5m])) + sum(rate(broadcast_count_total{type=\"kline\"}[5m]))) * 100",
          "legendFormat": "Dropped by Throttling (%)"
        }
      ]
    },
    {
      "title": "9. Broadcast Traffic Distribution (TPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "rate(broadcast_count_total{type=\"ticker\"}[1m])",
          "legendFormat": "Ticker (Every Tick)"
        },
        {
          "expr": "rate(broadcast_count_total{type=\"kline\"}[1m])",
          "legendFormat": "Kline (Throttled)"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
