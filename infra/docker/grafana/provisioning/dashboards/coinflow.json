{
  "title": "CoinFlow Real-Time Metrics",
  "uid": "coinflow-custom-dashboard",
  "tags": ["coinflow", "monitoring"],
  "timezone": "browser",
  "panels": [
    {
      "title": "1. WebSocket Tick Receive Rate (TPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(tick_receive_count_total[1m])",
          "legendFormat": "TPS ({{application}})"
        }
      ]
    },
    {
      "title": "2. Main Thread Latency (Pure Logic/Serialization µs)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "description": "틱 수신부터 비동기 작업(DB 저장 등) 위임 전까지의 순수 CPU 연산 시간",
      "targets": [
        {
          "expr": "tick_main_thread_latency_seconds{quantile=\"0.95\"} * 1000000",
          "legendFormat": "P95 (Pure Logic µs)"
        },
        {
          "expr": "tick_main_thread_latency_seconds{quantile=\"0.99\"} * 1000000",
          "legendFormat": "P99 (Pure Logic µs)"
        },
        {
          "expr": "rate(tick_main_thread_latency_seconds_sum[1m]) / rate(tick_main_thread_latency_seconds_count[1m]) * 1000000",
          "legendFormat": "Avg (Pure Logic µs)"
        }
      ]
    },
    {
      "title": "3. E2E Process Latency (Total/DB/ACK µs)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "description": "틱 수신부터 DB 영속화 및 ACK 완료까지의 전체 종단 간 시간",
      "targets": [
        {
          "expr": "tick_process_latency_seconds{quantile=\"0.95\"} * 1000000",
          "legendFormat": "P95 (Total µs)"
        },
        {
          "expr": "tick_process_latency_seconds{quantile=\"0.99\"} * 1000000",
          "legendFormat": "P99 (Total µs)"
        },
        {
          "expr": "rate(tick_process_latency_seconds_sum[1m]) / rate(tick_process_latency_seconds_count[1m]) * 1000000",
          "legendFormat": "Avg (Total µs)"
        }
      ]
    },
    {
      "title": "4. Redis XADD / ACK Latency (Avg ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(stream_publish_latency_seconds_sum[1m]) / rate(stream_publish_latency_seconds_count[1m]) * 1000",
          "legendFormat": "XADD Latency (ms)"
        },
        {
          "expr": "rate(stream_ack_latency_seconds_sum[1m]) / rate(stream_ack_latency_seconds_count[1m]) * 1000",
          "legendFormat": "ACK Latency (ms)"
        }
      ]
    },
    {
      "title": "5. API Caffeine Cache Hit Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=\"ohlc_chart_cache\", result=\"hit\"}[1m])) / sum(rate(cache_gets_total{cache=\"ohlc_chart_cache\"}[1m])) * 100",
          "legendFormat": "Hit Rate (%)"
        }
      ]
    },
    {
      "title": "6. Redis XADD Latency (P95, P99 ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "stream_publish_latency_seconds{quantile=\"0.95\"} * 1000",
          "legendFormat": "XADD P95"
        },
        {
          "expr": "stream_publish_latency_seconds{quantile=\"0.99\"} * 1000",
          "legendFormat": "XADD P99"
        }
      ]
    },
    {
      "title": "7. Redis ACK Latency (P95, P99 ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "stream_ack_latency_seconds{quantile=\"0.95\"} * 1000",
          "legendFormat": "ACK P95"
        },
        {
          "expr": "stream_ack_latency_seconds{quantile=\"0.99\"} * 1000",
          "legendFormat": "ACK P99"
        }
      ]
    },
    {
      "title": "8. Redis Stream Processing Lag (Backlog Count)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "redis_stream_group_lag",
          "legendFormat": "{{group}} (Lag: {{stream}})"
        }
      ]
    },
    {
      "title": "9. Redis Server Metrics (Mem & Clients)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Memory Usage (MB)"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Connected Clients (Count)"
        }
      ]
    },
    {
      "title": "10. Redis Stream Key Memory Usage (Bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "redis_key_size{key=\"tick:raw\"}",
          "legendFormat": "tick:raw stream size (bytes)"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
